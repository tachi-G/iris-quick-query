<UserControl x:Class="IrisQuickQuery.App.Views.AboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28,24" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Style="{StaticResource PageTitle}" Text="关于 IRIS 快捷查询"/><TextBlock Style="{StaticResource PageSubtitle}" Text="面向医院项目运维的本地只读 SQL 元素化查询工具。"/>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="版本" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding Version}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,16"/><TextBlock Text="隐私边界" FontWeight="SemiBold"/><TextBlock Text="快捷查询中的患者输入、派生字段和结果集只驻留内存，不写入日志或配置包。SQL 规则测试参数会按规则使用当前 Windows 用户 DPAPI 加密保存在本地；运行日志仍不记录任何患者值。" Margin="0,6,0,16" TextWrapping="Wrap"/><TextBlock Text="本地数据目录" FontWeight="SemiBold"/><TextBlock Text="{Binding DataPath}" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,16"/><Grid><StackPanel><TextBlock Text="诊断日志目录" FontWeight="SemiBold"/><TextBlock Text="{Binding LogPath}" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/></StackPanel><Button x:Name="AboutOpenLogFolderButton" Content="打开日志文件夹" Command="{Binding OpenLogFolderCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="V1 边界" FontWeight="SemiBold"/><TextBlock Text="单窗口 · 单服务器/Namespace · 参数化 SELECT/CTE · 无查询历史 · 无写操作 · 无自动更新" Margin="0,6,0,0"/></StackPanel></Border>
    </StackPanel>
</UserControl>
