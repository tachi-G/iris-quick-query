<UserControl x:Class="IrisQuickQuery.App.Views.QueryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:IrisQuickQuery.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVisible"/>
        <conv:BoolToVisibilityConverter x:Key="BoolCollapsed" Invert="True"/>

        <Style x:Key="QuerySectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="FieldRail" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BorderStrongBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateLabel}" Value="人工输入">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateLabel}" Value="SQL 回填">
                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateLabel}" Value="值冲突">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateLabel}" Value="格式错误">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldStateText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateLabel}" Value="人工输入">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateLabel}" Value="SQL 回填">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateLabel}" Value="值冲突">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateLabel}" Value="格式错误">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReadOnlyFieldValue" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="MinHeight" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditableQueryField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="8,7"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="QueryScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch" PreviewMouseWheel="PageScrollViewer_OnPreviewMouseWheel">
        <StackPanel Margin="32,24,32,40" MaxWidth="1180" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,24">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="患者数据工作区" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource PageTitle}" Text="患者信息快捷查询"/>
                    <TextBlock Text="从任意人工字段开始，系统按依赖顺序执行只读规则，并持续回填元素，直到结果稳定或需要人工选择。"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="14"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="QueryConditionsHeader" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="QueryConditionsTitle" Style="{StaticResource QuerySectionTitle}" Text="查询条件" VerticalAlignment="Center"/>
                <StackPanel x:Name="QueryActionButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="QueryClearButton" Style="{StaticResource SecondaryButton}" Content="清空"
                            Command="{Binding ClearCommand}" Margin="0,0,8,0"/>
                    <Button x:Name="QueryCancelButton" Style="{StaticResource SecondaryButton}" Content="取消查询"
                            Command="{Binding CancelCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsRunning,Converter={StaticResource BoolVisible}}"/>
                    <Button x:Name="QueryRunButton" Content="开始查询" Command="{Binding RunCommand}" MinWidth="112"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="Enter 运行  ·  F2 编辑回填值  ·  Ctrl+C 复制" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="ConditionsEditButton" Style="{StaticResource SecondaryButton}" Content="{Binding ConditionsEditButtonText}"
                            Command="{Binding ToggleConditionsEditCommand}" MinWidth="64"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="4"
                           Text="选择一个或多个全局元素作为查询条件；编辑状态可拖动卡片调整位置，按 Enter 以当前人工值开始新一轮查询。"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0"/>
            </Grid>

            <Border x:Name="ConditionPicker" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceMutedBrush}"
                    Padding="16" Margin="0,0,0,16" Visibility="{Binding IsEditingConditions,Converter={StaticResource BoolVisible}}">
                <StackPanel>
                    <TextBlock Text="添加查询条件" FontSize="16"/>
                    <TextBlock Text="下面列出所有尚未显示的全局元素；添加后，元素自身的配置决定输入框是否可编辑。"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,12"/>
                    <ItemsControl x:Name="AvailableConditionsList" ItemsSource="{Binding AvailableConditions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="12,8"
                                        Command="{Binding DataContext.AddConditionCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel MinWidth="150">
                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Left"/>
                                        <TextBlock FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12" HorizontalAlignment="Left">
                                            <TextBlock.Inlines><Run Text="{Binding Key,Mode=OneWay}"/></TextBlock.Inlines>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="已显示所有全局元素。" Foreground="{StaticResource TextMutedBrush}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvailableConditions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="ConditionsItemsControl" ItemsSource="{Binding Fields}" Margin="0,0,0,8"
                          AllowDrop="True" DragOver="ConditionsItemsControl_OnDragOver"
                          Drop="ConditionsItemsControl_OnDrop">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding DisplayWidth}" MinWidth="160" MinHeight="118"
                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" Margin="0,0,16,12" Tag="{Binding}"
                                PreviewMouseLeftButtonDown="ConditionCard_OnPreviewMouseLeftButtonDown"
                                PreviewMouseMove="ConditionCard_OnPreviewMouseMove">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource FieldRail}"/>
                                <Grid Grid.Column="1" Margin="16,8,16,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Definition.Label}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Definition.Key}" FontSize="12" Margin="0,2,0,0"
                                                       FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="移除" MinHeight="28"
                                                Padding="8,2" Margin="8,0,0,0" FontSize="12"
                                                Command="{Binding DataContext.RemoveConditionCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.IsEditingConditions,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource BoolVisible}}"/>
                                    </Grid>
                                    <TextBox Grid.Row="1" Style="{StaticResource EditableQueryField}" Margin="-10,8,-10,0"
                                             Text="{Binding InputText,UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsEditorVisible,Converter={StaticResource BoolVisible}}"
                                             KeyDown="FieldEditor_OnKeyDown" IsVisibleChanged="FieldEditor_OnIsVisibleChanged" Tag="{Binding}"/>
                                     <Border Grid.Row="1" Style="{StaticResource ReadOnlyFieldValue}" Margin="-10,8,-10,0"
                                             Visibility="{Binding IsEditorVisible,Converter={StaticResource BoolCollapsed}}">
                                        <Grid>
                                            <TextBox Text="{Binding InputText,Mode=OneWay}" FontSize="16" Foreground="{StaticResource TextMutedBrush}"
                                                     Background="Transparent" BorderThickness="0" Padding="0" IsReadOnly="True"
                                                     IsReadOnlyCaretVisible="True" VerticalContentAlignment="Center"
                                                     PreviewMouseLeftButtonDown="ReadOnlyField_OnPreviewMouseLeftButtonDown" Tag="{Binding}"
                                                     PreviewKeyDown="ReadOnlyField_OnPreviewKeyDown"/>
                                            <TextBlock Text="{Binding CopyHint}" Foreground="{StaticResource SuccessBrush}"
                                                       HorizontalAlignment="Right" FontSize="12" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="{Binding SourceLabel,StringFormat=来源：{0}}"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,6,0,0"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,0,0,16">
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource QuerySectionTitle}" Text="查询结果"/>
                        <TextBlock Text="规则返回多条记录时，选择一条记录后系统会继续执行下游查询。"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding ListResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="QueryResultCard" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                Margin="0,0,0,16" HorizontalAlignment="Left">
                            <StackPanel>
                                <Border Background="{StaticResource SurfaceMutedBrush}" Padding="16,12">
                                    <Grid>
                                        <TextBlock Text="{Binding RuleName}" FontSize="16"/>
                                        <TextBlock Text="{Binding SelectionHint}" Foreground="{StaticResource PrimaryDarkBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <DataGrid ItemsSource="{Binding Rows}" SelectedIndex="{Binding SelectedIndex,Mode=TwoWay}"
                                          IsReadOnly="True" SelectionMode="Single" MaxHeight="300" BorderThickness="0,1,0,0"
                                          HorizontalAlignment="Left" ColumnWidth="Auto" MinColumnWidth="90" MaxColumnWidth="260"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="RuleTraceSection" BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="规则运行轨迹" FontSize="16" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding TraceItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RuleName}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Status}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{StaticResource TextMutedBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
