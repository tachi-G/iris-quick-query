<UserControl x:Class="IrisQuickQuery.App.Views.ElementsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,28" DataContext="{Binding Session}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Style="{StaticResource PageTitle}" Text="全局业务元素"/><TextBlock Style="{StaticResource PageSubtitle}" Text="全局元素标识供 SQL 引用，中文名称与布局属性只负责前台展示。"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Style="{StaticResource SecondaryButton}" Content="新增元素" Command="{Binding AddElementCommand}" Margin="0,0,8,0"/><Button Style="{StaticResource DangerButton}" Content="删除所选" Command="{Binding RemoveElementCommand}"/></StackPanel></Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DataGrid x:Name="ElementsGrid" ItemsSource="{Binding Elements}" SelectedItem="{Binding SelectedElement}"
                      AutoGenerateColumns="False" CanUserAddRows="False" FontSize="15" RowHeight="40" ColumnHeaderHeight="42"
                      CanUserSortColumns="False" Width="560" HorizontalAlignment="Left"
                      GridLinesVisibility="All" HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}"
                      VerticalGridLinesBrush="{StaticResource BorderSubtleBrush}">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style x:Key="ElementGridText" TargetType="TextBlock">
                        <Setter Property="Margin" Value="12,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    </Style>
                    <Style x:Key="ElementGridEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style x:Key="ElementGridCheckBox" TargetType="CheckBox">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="全局元素" Binding="{Binding Key,UpdateSourceTrigger=PropertyChanged}" Width="150"
                                        ElementStyle="{StaticResource ElementGridText}" EditingElementStyle="{StaticResource ElementGridEditor}"/>
                    <DataGridTextColumn Header="中文名称" Binding="{Binding Label,UpdateSourceTrigger=PropertyChanged}" Width="130"
                                        ElementStyle="{StaticResource ElementGridText}" EditingElementStyle="{StaticResource ElementGridEditor}"/>
                    <DataGridTextColumn Header="宽度" Binding="{Binding Width,ValidatesOnExceptions=True,UpdateSourceTrigger=LostFocus}" Width="70"
                                        ElementStyle="{StaticResource ElementGridText}" EditingElementStyle="{StaticResource ElementGridEditor}"/>
                    <DataGridCheckBoxColumn Header="可人工输入" Binding="{Binding CanInput,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="100"
                                            ElementStyle="{StaticResource ElementGridCheckBox}" EditingElementStyle="{StaticResource ElementGridCheckBox}"/>
                    <DataGridCheckBoxColumn Header="是否日期" Binding="{Binding IsDate,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="90"
                                            ElementStyle="{StaticResource ElementGridCheckBox}" EditingElementStyle="{StaticResource ElementGridCheckBox}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Grid x:Name="ElementsFooter" Grid.Row="2" Height="52">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ElementStatusText" Text="{Binding ElementStatusMessage}" Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
            <Button x:Name="SaveElementsButton" Grid.Column="1" Width="72" Height="36" VerticalAlignment="Center"
                    Content="保存" Command="{Binding SaveCommand}" CommandParameter="elements" Click="SaveElementsButton_OnClick"/>
        </Grid>
    </Grid>
</UserControl>
